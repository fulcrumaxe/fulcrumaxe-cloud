"/*\n * H24 shared design layer — base + component rules.\n *\n * Ported (values and rules, never content) from the read-only\n * formal-support site's stylesheet — black ground, monospace, \"// Section\"\n * heading rhythm, terminal-green accent. See D#2's spec amendment comment\n * for the full port rationale and the source path (not repeated here: this\n * file ships as literal output CSS, and a local filesystem path has no\n * business in a shipped asset).\n *\n * Every colour, spacing step, type-scale step, radius and container width\n * below is a var(--token) resolved by whatever :root block renderTokens()\n * emitted before this file loads (src/css/tokens.ts). The only literals\n * allowed outside that are the ones the hardcoded-value guard test\n * (test/hardcoded-guard.test.ts) documents: hairline `1px` borders, bare\n * `0`, and `100%`.\n *\n * Selector groups, in order:\n *   1. Reset + global (body, links, main, section, headings, lists)\n *   2. Header      — .site-header / .site-name (H24's Header component;\n *                    also packages/sitekit-template's existing markup, so\n *                    K03 renders unchanged once its own theme file is gone)\n *   3. Footer      — .site-footer (ditto)\n *   4. Button      — .cta / .evidence (ditto)\n *   5. Card        — .card-grid / .card / .card-label / .card-title /\n *                    .card-body / .card-link (new — for the marketing site,\n *                    apps/web and the dashboard)\n *   6. Code block  — .code-block / .code-head (new)\n *   7. Page states — .state-msg, loading/empty/error (new)\n */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--font-mono);\n  font-size: var(--text-md);\n  line-height: 1.6;\n}\n\na {\n  color: var(--accent);\n  text-decoration: none;\n}\na:hover {\n  text-decoration: underline;\n}\n\nmain {\n  max-width: var(--max);\n  margin: 0 auto;\n  padding: var(--space-lg);\n}\n\nsection {\n  max-width: var(--max);\n  margin: 0 auto var(--space-lg);\n  padding: var(--space-lg);\n  background: var(--bg-raised);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n}\n\n.section-heading {\n  margin: 0 0 var(--space-md) 0;\n  color: var(--accent);\n  text-transform: uppercase;\n  font-size: var(--text-sm);\n  letter-spacing: var(--tracking-wide);\n}\n.section-heading::before {\n  content: \"// \";\n  color: var(--fg-dim);\n}\n\nul,\n.faq-item,\n.pricing-plans {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\nli,\n.pricing-plans li {\n  padding: var(--space-2xs) 0;\n  border-bottom: 1px solid var(--border);\n}\nli:last-child,\n.pricing-plans li:last-child {\n  border-bottom: none;\n}\n\n/* ---------- Header ---------- */\n.site-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: var(--space-md);\n  padding: var(--space-md) var(--space-lg);\n  border-bottom: 1px solid var(--border);\n  max-width: var(--max);\n  margin: 0 auto;\n}\n.site-name {\n  font-weight: 700;\n  letter-spacing: var(--tracking-wide);\n  text-decoration: none;\n  color: var(--fg);\n}\n.site-header nav {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-md);\n}\n.site-header nav a {\n  text-decoration: none;\n  color: var(--fg-dim);\n  font-size: var(--text-sm);\n}\n.site-header nav a:hover,\n.site-header nav a[aria-current=\"page\"] {\n  color: var(--accent);\n}\n\n/* ---------- Footer ---------- */\n.site-footer {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-md);\n  justify-content: space-between;\n  max-width: var(--max);\n  margin: 0 auto;\n  padding: var(--space-lg);\n  color: var(--fg-dim);\n  font-size: var(--text-sm);\n}\n.site-footer a {\n  color: var(--fg-dim);\n}\n.site-footer a:hover {\n  color: var(--accent);\n}\n\n/* ---------- Button ---------- */\n.cta {\n  display: inline-block;\n  font-family: inherit;\n  font-size: var(--text-sm);\n  letter-spacing: var(--tracking-wide);\n  text-transform: uppercase;\n  padding: var(--space-2xs) var(--space-sm);\n  margin-top: var(--space-md);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius);\n  background: transparent;\n  color: var(--accent);\n  text-decoration: none;\n  cursor: pointer;\n  transition: background 0.2s ease, border-color 0.2s ease;\n}\n.cta:hover {\n  background: var(--accent-faint);\n}\n.cta:focus-visible {\n  background: var(--accent-faint);\n  outline: none;\n  box-shadow: 0 0 0 var(--space-3xs) var(--accent);\n}\n.cta-primary {\n  background: var(--accent-wash);\n}\n.cta:disabled,\n.cta[aria-disabled=\"true\"] {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.evidence {\n  font-size: var(--text-xs);\n  color: var(--fg-dim);\n  text-decoration: none;\n}\n.evidence:hover {\n  color: var(--accent);\n}\n\n.hero-bg {\n  max-width: 100%;\n  border-radius: var(--radius);\n  margin-top: var(--space-md);\n}\n\n/* ---------- Card ---------- */\n.card-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(var(--card-min), 1fr));\n  gap: var(--space-md);\n}\n.card {\n  background: var(--bg-raised);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: var(--space-lg);\n  transition: border-color 0.2s ease;\n}\n.card:hover,\na.card:hover {\n  border-color: var(--accent-dim);\n  text-decoration: none;\n}\n.card-label {\n  font-size: var(--text-2xs);\n  letter-spacing: var(--tracking-wider);\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: var(--space-2xs);\n}\n.card-title {\n  font-size: var(--text-lg);\n  color: var(--accent);\n  font-weight: 700;\n  margin-bottom: var(--space-2xs);\n}\n.card-body {\n  color: var(--fg-dim);\n  font-size: var(--text-md);\n}\n.card-link {\n  display: inline-block;\n  margin-top: var(--space-md);\n  font-size: var(--text-sm);\n  letter-spacing: var(--tracking-wide);\n}\n\n/* ---------- Code block ---------- */\n.code-block {\n  position: relative;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  margin: var(--space-lg) 0;\n}\n.code-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--space-2xs) var(--space-md);\n  border-bottom: 1px solid var(--border);\n  font-size: var(--text-2xs);\n  letter-spacing: var(--tracking-wider);\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.code-block pre {\n  padding: var(--space-md);\n  margin: 0;\n  overflow-x: auto;\n}\n.code-block code {\n  font-family: var(--font-mono);\n  font-size: var(--text-sm);\n  line-height: 1.7;\n  color: var(--fg);\n  white-space: pre;\n}\n\n/* ---------- Page states: loading, empty, error ---------- */\n.state-msg {\n  color: var(--fg-dim);\n  font-size: var(--text-md);\n  padding: var(--space-xl) 0;\n  text-align: center;\n}\n.state-msg.error {\n  color: var(--danger);\n}\n\n/* ---------- Skip link (hidden until focused) ---------- */\n.skip-link {\n  position: absolute;\n  top: 0;\n  left: 0;\n  z-index: 1;\n  padding: var(--space-2xs) var(--space-sm);\n  background: var(--bg-raised);\n  color: var(--accent);\n  transform: translateY(-200%);\n}\n.skip-link:focus,\n.skip-link:focus-visible {\n  transform: translateY(0);\n}\n\n/* ---------- Reduced motion ---------- */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    transition-duration: 0.01ms !important;\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n}\n"
