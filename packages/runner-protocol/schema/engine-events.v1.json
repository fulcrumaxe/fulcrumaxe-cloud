        "v": {
          "const": 1
        },
        "engine_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "const": "agent_started"
        },
