{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "fixtures/**/*.ts", "pw/**/*.ts", "packs/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
